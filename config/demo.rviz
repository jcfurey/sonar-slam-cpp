Panels:
  - Class: rviz_common/Displays
    Name: Displays
  - Class: rviz_common/Views
    Name: Views
Visualization Manager:
  Class: ""
  Displays:
    - Class: rviz_default_plugins/Grid
      Enabled: true
      Name: Grid
      Plane Cell Count: 30
    - Class: rviz_default_plugins/TF
      Enabled: true
      Name: TF
      Show Arrows: false
      Show Names: true
    - Class: rviz_default_plugins/PointCloud2
      Enabled: true
      Name: SLAM map cloud
      Topic:
        Value: /bruce/slam/slam/cloud
        Durability Policy: Transient Local
        Reliability Policy: Reliable
      Color Transformer: AxisColor
      Size (m): 0.12
      Style: Flat Squares
    - Class: rviz_default_plugins/PointCloud2
      Enabled: true
      Name: Trajectory
      Topic:
        Value: /bruce/slam/slam/traj
        Durability Policy: Transient Local
        Reliability Policy: Reliable
      Color Transformer: FlatColor
      Color: 255; 85; 0
      Size (m): 0.25
      Style: Spheres
    - Class: rviz_default_plugins/Map
      Enabled: true
      Name: Occupancy
      Topic:
        Value: /bruce/slam/mapping/occupancy
        Durability Policy: Transient Local
        Reliability Policy: Reliable
    - Class: rviz_default_plugins/Marker
      Enabled: true
      Name: Constraints
      Topic:
        Value: /bruce/slam/slam/constraint
        Durability Policy: Transient Local
        Reliability Policy: Reliable
  Global Options:
    Fixed Frame: map
    Frame Rate: 30
  Tools:
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/SetInitialPose
      Covariance x: 0.25
      Covariance y: 0.25
      Covariance yaw: 0.06853891909122467
      Topic:
        Value: /initialpose
  Views:
    Current:
      Class: rviz_default_plugins/TopDownOrtho
      Name: Current View
      Scale: 40
      X: 10
      Y: 5
Window Geometry:
  Height: 900
  Width: 1400
