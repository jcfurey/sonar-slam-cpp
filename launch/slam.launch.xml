<?xml version="1.0"?>
<launch>
  <arg name="use_sim_time" default="false"/>
  <arg name="namespace" default="/bruce/slam"/>
  <arg name="config_dir"
       default="$(find-pkg-share sonar_slam_cpp)/config"/>
  <arg name="points_topic"
       default="/sensor/sonar/sonar0/proc_points"/>
  <arg name="input_model" default="imaging">
    <choice value="imaging"/>
    <choice value="measured_xyz"/>
  </arg>
  <arg name="map_frame" default="map"/>
  <arg name="registration_model" default="constrained_xyyaw">
    <choice value="constrained_xyyaw"/>
    <choice value="se3"/>
  </arg>
  <arg name="map_calibration_id" default=""/>
  <arg name="map_depth_datum" default="pressure_zero"/>
  <arg name="odom_frame" default="odom"/>
  <arg name="base_frame" default="base_link"/>
  <arg name="publish_tf" default="true"/>

  <node pkg="sonar_slam_cpp" exec="slam_node" name="slam"
        namespace="$(var namespace)" output="screen">
    <param name="use_sim_time" value="$(var use_sim_time)"/>
    <param from="$(var config_dir)/slam.yaml"/>
    <param name="points_topic" value="$(var points_topic)"/>
    <param name="input_model" value="$(var input_model)"/>
    <param name="registration_model" value="$(var registration_model)"/>
    <param name="map_calibration_id" value="$(var map_calibration_id)" type="str"/>
    <param name="map_depth_datum" value="$(var map_depth_datum)" type="str"/>
    <param name="map_frame" value="$(var map_frame)"/>
    <param name="odom_frame" value="$(var odom_frame)"/>
    <param name="base_frame" value="$(var base_frame)"/>
    <param name="publish_tf" value="$(var publish_tf)"/>
    <param name="icp_config" value="$(var config_dir)/icp.yaml"/>
  </node>
</launch>
